# Copy to .env.local. Vite only exposes VITE_-prefixed vars to the client.

# The ONLY backend origin this app may talk to (frontend.md: all API
# calls go through api-gateway, never directly to a service).
VITE_GATEWAY_URL=http://localhost:8080

# Stripe PUBLISHABLE key. Public by design — it can only drive Stripe's
# own hosted iframe. The secret key must never appear in this file or in
# any client bundle: payment-service is the sole holder of provider
# credentials (ADR-011).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
