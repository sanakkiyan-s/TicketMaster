{
  "title": "TicketMaster - Service Overview",
  "uid": "tm-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by service + route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (exported_job, http_route) (rate(http_server_request_duration_seconds_count[1m]))",
          "legendFormat": "{{exported_job}} {{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (exported_job, le) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{exported_job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (5xx) by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "{{exported_job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM heap used by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{exported_job}} {{id}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM GC time by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(jvm_gc_collection_seconds_sum[5m])",
          "legendFormat": "{{exported_job}} {{gc}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Debezium replication lag (outbox connectors)",
      "description": "-1 means Debezium hasn't streamed any change event yet since last connector (re)start - not a fault, just idle. Real lag only appears once an event flows.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "debezium_postgres_connector_metrics_millisecondsbehindsource{context=\"streaming\"}",
          "legendFormat": "{{server}}"
        }
      ]
    }
  ]
}
